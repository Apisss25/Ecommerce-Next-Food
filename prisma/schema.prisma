generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PENJUAL
  PEMBELI
}

// ADMIN adalah penjual yang mengelola menu dan restock.
// PENJUAL adalah penjual yang hanya dapat menambahkan dan mengupdate menu.
// PEMBELI hanya melihat menu di aplikasi pembeli.
model User {
  id           String      @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PEMBELI)
  createdAt    DateTime @default(now())
}

